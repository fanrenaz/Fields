# Copy this file to .env before starting Compose.
# Use a URL-safe password because it is interpolated into DATABASE_URL.
FIELDS_POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
BETTER_AUTH_SECRET=replace-with-at-least-32-high-entropy-characters
FIELDS_FILE_SHARE_SECRET=replace-with-an-independent-32-character-secret
FIELDS_RUSTFS_ROOT_ACCESS_KEY=replace-with-rustfs-root-access-key
FIELDS_RUSTFS_ROOT_SECRET_KEY=replace-with-rustfs-root-secret-key
FIELDS_COMPANY_FILES_ACCESS_KEY_ID=replace-with-files-access-key
FIELDS_COMPANY_FILES_SECRET_ACCESS_KEY=replace-with-files-secret-key
FIELDS_COMPANY_ASSETS_ACCESS_KEY_ID=replace-with-assets-access-key
FIELDS_COMPANY_ASSETS_SECRET_ACCESS_KEY=replace-with-assets-secret-key
FIELDS_OBJECT_STORAGE_PUBLIC_ENDPOINT=https://files.fields.example.com
FIELDS_OBJECT_STORAGE_REGION=us-east-1

# Public browser origin. Do not include a trailing slash.
FIELDS_PUBLIC_ORIGIN=https://fields.example.com

# Web Push VAPID identity. Generate one key pair and keep the private key only
# in the production environment consumed by the Event worker.
FIELDS_WEB_PUSH_SUBJECT=mailto:operations@fields.example.com
FIELDS_WEB_PUSH_VAPID_PUBLIC_KEY=replace-with-vapid-public-key
FIELDS_WEB_PUSH_VAPID_PRIVATE_KEY=replace-with-vapid-private-key

# The Gateway serves HTTP only behind the shared host Caddy. Public
# TLS and the fields.example.com virtual host are owned by that shared proxy.
FIELDS_SITE_ADDRESS=:80

# Public HTTPS origin that stores desktop installers and the release manifest.
# Do not include a trailing slash, path, query string, or storage credentials.
FIELDS_DESKTOP_BLOB_ORIGIN=https://cdn.example.com

# This absolute file must exist on the Docker host and contain one high-entropy
# control-plane bearer token. Backend, Controller, and Event mount the same path read-only.
FIELDS_INTERNAL_CONTROL_TOKEN_FILE=/absolute/path/to/fields-control-token

# Required by the Embodiment Runtime for real Qwen TTS and ASR. The Runtime
# fails to start without this key; it never falls back to synthesized fixture audio.
DASHSCOPE_API_KEY=replace-with-a-DashScope-api-key
# DashScope speech defaults. Override these only after validating the selected
# model and voice support the Embodiment PCM contract.
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
QWEN_TTS_MODEL=qwen3-tts-flash
QWEN_STT_MODEL=qwen3-asr-flash
QWEN_TTS_VOICE=Cherry
QWEN_TTS_LANGUAGE=Auto

FIELDS_IMAGE_TAG=latest
FIELDS_IMAGE_PULL_POLICY=always
# Full tag or digest references override the default ACR latest tags.
FIELDS_BACKEND_IMAGE=registry.example.com/fields/backend:${FIELDS_IMAGE_TAG}
FIELDS_GATEWAY_IMAGE=registry.example.com/fields/gateway:${FIELDS_IMAGE_TAG}
# For an existing deployment, set these to the sole current Company ID and
# its existing Company Runtime Docker volume name before the atomic cutover.
FIELDS_INTERNAL_COMPANY_ID=company_<replace-me>
FIELDS_COMPANY_RUNTIME_VOLUME_NAME=fields-company-runtime-data
FIELDS_COMPANY_RUNTIME_HEARTBEAT_TIMEOUT_MS=45000
FIELDS_CONTROL_NETWORK=fields-control
FIELDS_RUNTIME_NETWORK=fields-runtime
# The HK project-local gateway exports best-effort telemetry over authenticated
# HTTPS. The token file must be absolute, regular, non-symlinked, and mode 0600.
FIELDS_OBSERVABILITY_EXPORT_ENDPOINT=https://otel.fields.example.com/otlp
FIELDS_OBSERVABILITY_EXPORT_TOKEN_FILE=/absolute/path/to/fields-observability-export-token
# Shared Caddy proxies its Fields virtual host to this Docker-host binding.
FIELDS_GATEWAY_BIND_IP=172.17.0.1
FIELDS_GATEWAY_PORT=61080
