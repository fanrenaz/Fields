{
  "name": "@sticks3-call/simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "pc": "tsx src/pc-server.ts",
    "pc:dev": "tsx watch src/pc-server.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@fields/contracts": "workspace:*",
    "@trpc/client": "^11.7.2",
    "ws": "^8.21.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.21",
    "@types/ws": "^8.18.1",
    "tsx": "^4.22.4",
    "typescript": "6.0.3"
  }
}
