{
  "name": "@fields/frontend",
  "private": true,
  "version": "1.0.28",
  "description": "Fields desktop and mobile PWA clients",
  "author": "Fields AI",
  "main": "index",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3103",
    "build": "vite build",
    "desktop:export": "node desktop/export.cjs",
    "desktop:start": "pnpm run desktop:export && electron-forge start",
    "desktop:package": "pnpm run desktop:export && electron-forge package",
    "desktop:make:prepared": "electron-forge package --platform=win32 --arch=x64 && electron-builder --win nsis --x64 --prepackaged out/Fields-win32-x64 --config desktop/electron-builder.cjs --publish never",
    "desktop:make": "pnpm run desktop:export && pnpm run desktop:make:prepared",
    "pwa:export": "node pwa/export.cjs",
    "renderer:smoke": "node tests/renderer/room-runtime.renderer.mjs && node tests/renderer/company-onboarding.renderer.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "NODE_PATH=./node_modules node ../scripts/run-ts-tests.mjs tests --test-concurrency=4",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@headless-tree/core": "^1.7.0",
    "@headless-tree/react": "^1.7.0",
    "@lobehub/editor": "4.23.0",
    "@lobehub/fluent-emoji": "4.1.0",
    "@lobehub/icons": "5.15.0",
    "@lobehub/ui": "5.23.4",
    "@fields/contracts": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-zone": "^2.9.0",
    "@opentelemetry/core": "^2.9.0",
    "@opentelemetry/instrumentation-document-load": "^0.65.0",
    "@opentelemetry/instrumentation-fetch": "^0.220.0",
    "@opentelemetry/instrumentation-xml-http-request": "^0.220.0",
    "@opentelemetry/sdk-trace-base": "^2.9.0",
    "@opentelemetry/sdk-trace-web": "^2.9.0",
    "@trpc/client": "^11.7.2",
    "@xstate/react": "^6.1.0",
    "antd": "6.1.1",
    "antd-style": "4.1.0",
    "better-auth": "1.6.23",
    "dayjs": "^1.11.21",
    "es-toolkit": "^1.49.0",
    "fast-deep-equal": "^3.1.3",
    "i18next": "^26.3.6",
    "immer": "^11.1.8",
    "lexical": "0.42.0",
    "lucide-react": "1.26.0",
    "motion": "12.42.2",
    "pdfjs-dist": "5.4.296",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.10",
    "react-pdf": "^10.4.1",
    "react-router": "8.3.0",
    "react-virtuoso": "^4.18.10",
    "type-fest": "^5.7.0",
    "ulid": "3.0.2",
    "xstate": "^5.32.2",
    "zod": "^4.4.3",
    "zustand": "5.0.4",
    "zustand-utils": "^2.1.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@fields/eslint-config": "workspace:*",
    "@types/node": "^22.19.21",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.0.4",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "node": "22.22.3",
    "tsx": "^4.22.4",
    "typescript": "6.0.3",
    "vite": "8.1.5"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "postcss": "^8.5.15",
    "uuid": "11.1.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
