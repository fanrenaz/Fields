{
  "name": "@fields/company-runtime",
  "version": "0.1.3",
  "private": true,
  "description": "Company-isolated Fields runtime and Executor credential authority.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "fields-company-runtime": "./dist/interface/server.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx src/interface/server.ts",
    "start": "node --import ./dist/observability/bootstrap.js dist/interface/server.js",
    "build": "tsc -p tsconfig.build.json",
    "generate:codex-protocol": "node scripts/generate-codex-protocol.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node ../scripts/run-ts-tests.mjs tests --test-force-exit",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@fields/eslint-config": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.19.21",
    "@types/nodemailer": "^8.0.1",
    "@types/sanitize-html": "^2.16.1",
    "@types/unzipper": "^0.10.11",
    "@types/ws": "^8.18.1",
    "tsx": "^4.22.4",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "~3.932.0",
    "@fastify/websocket": "^11.2.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@fields/contracts": "workspace:*",
    "@openai/codex": "0.145.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.220.0",
    "@opentelemetry/auto-instrumentations-node": "^0.78.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@opentelemetry/sdk-trace-base": "^2.9.0",
    "@trpc/client": "^11.7.2",
    "@trpc/server": "^11.7.2",
    "better-sqlite3": "^13.0.1",
    "fastify": "^5.8.5",
    "fflate": "^0.8.3",
    "imapflow": "^1.5.0",
    "mailparser": "^3.9.14",
    "nodemailer": "^9.0.3",
    "sanitize-html": "^2.17.6",
    "smol-toml": "^1.7.0",
    "unzipper": "^0.12.3",
    "ws": "^8.21.0",
    "zod": "^4.2.1"
  }
}
