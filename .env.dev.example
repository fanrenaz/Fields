# Required only by the voice, simulator, and full development profiles.
DASHSCOPE_API_KEY=replace-with-a-DashScope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
QWEN_TTS_MODEL=qwen3-tts-flash
QWEN_STT_MODEL=qwen3-asr-flash
QWEN_TTS_VOICE=Cherry
QWEN_TTS_LANGUAGE=Auto

# Stable single-Company development identity and Runtime volume.
FIELDS_INTERNAL_COMPANY_ID=company_internal
FIELDS_COMPANY_RUNTIME_VOLUME_NAME=fields-dev-company-runtime-data
