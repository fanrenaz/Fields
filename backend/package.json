{
  "name": "@fields/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "node --watch --import tsx --import ./src/observability/bootstrap.ts src/index.ts",
    "event:dev": "node --watch --import tsx --import ./src/observability/bootstrap.ts src/composition/event/main.ts",
    "event:start": "node --import ./dist/observability/bootstrap.js dist/composition/event/main.js",
    "embodiment:dev": "node --watch --import tsx --import ./src/observability/bootstrap.ts src/composition/embodiment/main.ts",
    "embodiment:start": "node --import ./dist/observability/bootstrap.js dist/composition/embodiment/main.js",
    "build": "tsc -p tsconfig.build.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "development-runtime:reset": "tsx src/ops/reset-development-runtimes-main.ts",
    "environment:reset": "tsx src/ops/reset-environment-main.ts",
    "company:bootstrap": "node --import ./dist/observability/bootstrap.js dist/ops/bootstrap-default-company-main.js",
    "integration:auth-company": "tsx --test --test-concurrency=1 tests/auth-company.integration.test.ts",
    "integration:company-onboarding": "tsx --test --test-concurrency=1 tests/company-onboarding.integration.test.ts",
    "integration:company-runtime": "tsx --test tests/company-runtime.integration.test.ts",
    "integration:eventing": "tsx --test tests/eventing.integration.test.ts",
    "integration:executor-migration-upgrade": "tsx --test --test-concurrency=1 tests/executor-migration-upgrade.integration.test.ts",
    "integration:embodiment": "tsx --test --test-concurrency=1 tests/embodiment.integration.test.ts",
    "integration:mail": "tsx --test --test-concurrency=1 tests/mail.integration.test.ts",
    "integration:company-files": "tsx --test --test-concurrency=1 tests/company-files.integration.test.ts",
    "integration:observability-compose": "bash ../scripts/observability-compose-integration.sh",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "smoke:compose-empty-db": "bash ../scripts/compose-empty-db-smoke.sh",
    "test": "node ../scripts/run-ts-tests.mjs tests/unit",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node --import ./dist/observability/bootstrap.js dist/index.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "~3.932.0",
    "@aws-sdk/s3-request-presigner": "~3.932.0",
    "@better-auth/drizzle-adapter": "1.6.23",
    "@fastify/cors": "^11.2.0",
    "@fastify/websocket": "^11.2.0",
    "@fields/contracts": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.220.0",
    "@opentelemetry/auto-instrumentations-node": "^0.78.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@opentelemetry/sdk-trace-base": "^2.9.0",
    "@trpc/client": "^11.7.2",
    "@trpc/server": "^11.7.2",
    "better-auth": "1.6.23",
    "cron-parser": "5.6.2",
    "dockerode": "^5.0.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "pg": "^8.22.0",
    "web-push": "3.6.7",
    "ws": "^8.21.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@fields/eslint-config": "workspace:*",
    "@types/dockerode": "^4.0.1",
    "@types/node": "^22.19.21",
    "@types/pg": "^8.20.0",
    "@types/web-push": "3.6.4",
    "@types/ws": "^8.18.1",
    "tsx": "^4.22.4",
    "typescript": "6.0.3"
  }
}
