# Copy to backend/.env for direct API, Event, or Embodiment commands.
FIELDS_BACKEND_LOAD_ENV_FILES=true
FIELDS_BACKEND_HOST=127.0.0.1
FIELDS_BACKEND_PORT=4102
FIELDS_BACKEND_PUBLIC_API_URL=http://host.docker.internal:4102/api/v1
FIELDS_BACKEND_DATABASE_URL=postgresql://fields:fields@127.0.0.1:5432/fields
FIELDS_CLIENT_ORIGINS=http://127.0.0.1:3102

BETTER_AUTH_SECRET=replace-with-at-least-32-high-entropy-characters
FIELDS_FILE_SHARE_SECRET=replace-with-an-independent-32-character-secret
BETTER_AUTH_URL=http://127.0.0.1:3102
FIELDS_AUTH_TRUSTED_ORIGINS=http://127.0.0.1:3102

FIELDS_INTERNAL_COMPANY_ID=company_internal
FIELDS_COMPANY_RUNTIME_URL=http://127.0.0.1:4110
FIELDS_COMPANY_RUNTIME_VOLUME_NAME=fields-dev-company-runtime-data
FIELDS_COMPANY_RUNTIME_CALLBACK_BASE_URL=http://127.0.0.1:4102/api/v1

FIELDS_INTERNAL_CONTROL_TOKEN_FILE=/absolute/process-visible/path/to/fields-control-token
FIELDS_EVENT_HOST=127.0.0.1
FIELDS_EVENT_PORT=4104
FIELDS_EMBODIMENT_RUNTIME_URL=http://127.0.0.1:4105
